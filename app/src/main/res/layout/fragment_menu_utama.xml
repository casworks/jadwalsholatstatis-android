<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/menuTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_utama_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menuSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/menu_utama_subtitle" />

        <TextView
            android:id="@+id/menuSectionLokasi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/menu_utama_lokasi_title"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputLokasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/menu_utama_lokasi_hint"
            android:inputType="textCapWords" />

        <Button
            android:id="@+id/buttonSimpanLokasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/menu_utama_lokasi_button" />

        <TextView
            android:id="@+id/menuSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/menu_utama_menu_title"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonMenuJadwal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/menu_utama_jadwal" />

        <Button
            android:id="@+id/buttonMenuCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/menu_utama_countdown" />

        <Button
            android:id="@+id/buttonMenuPengingat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/menu_utama_pengingat" />
    </LinearLayout>
</ScrollView>
